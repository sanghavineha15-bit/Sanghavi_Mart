# ============================================================
# Environment Variables for Sanghavi Mart
# Copy to .env for local development (DO NOT commit .env)
# ============================================================

# Server port (Railway sets this automatically)
PORT=8080

# Database Configuration (choose ONE method):

# Method 1: DATABASE_URL (Railway/Production - preferred)
# Format: postgresql://user:password@host:port/database
# DATABASE_URL=postgresql://postgres:password@localhost:5432/sanghavi_mart

# Method 2: Individual variables (Local development)
DB_HOST=localhost
DB_PORT=5433
DB_NAME=sanghavi_mart
DB_USER=postgres
DB_PASSWORD=postgres

# Firebase Admin SDK (Node backend only - C++ Drogon CANNOT use the JSON directly)
# NEVER commit the *-firebase-adminsdk-*.json file. Keep it outside the repo
# (e.g. C:\Users\Sanghavi\Downloads\) and paste values as env vars on Railway/Vercel.
# FIREBASE_PROJECT_ID=sanghavi-3b9d3
# FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@sanghavi-3b9d3.iam.gserviceaccount.com
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
# Frontend web config (public, safe in index.html): apiKey/authDomain/projectId/appId