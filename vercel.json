{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://REPLACE-WITH-RAILWAY-URL.up.railway.app/api/:path*"
    },
    {
      "source": "/",
      "destination": "/config/login.html"
    }
  ],
  "headers": [
    {
      "source": "/config/login.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    }
  ]
}
